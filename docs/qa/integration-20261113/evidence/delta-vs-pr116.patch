index 0000000..ea942a6
--- /dev/null
+++ b/tests/media_import_real_chromium.py
@@ -0,0 +1,130 @@
+#!/usr/bin/env python3
+"""Opt-in browser regression: real Chromium IndexedDB transactions & restart.
+
+Run on a trusted checkout only. Uses a fresh temporary localhost origin and a
+throw-away browser profile. NEVER uses the user's production browser profile.
+Not an Android file picker, power-loss, or source-byte preservation test.
+"""
+from __future__ import annotations
+
+from functools import partial
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from threading import Thread
+import os
+import sys
+
+from playwright.sync_api import sync_playwright
+
+ROOT = Path(__file__).resolve().parents[1]
+OWNER = ROOT / 'app/src/main/assets/media-import-ownership.js'
+
+
+class QuietHandler(SimpleHTTPRequestHandler):
+    def log_message(self, *_):
+        pass
+
+
+def main() -> int:
+    if not OWNER.is_file():
+        print('BLOCKED: real production media-import-ownership.js missing', file=sys.stderr)
+        return 2
+    # Browsers need a normal secure-enough origin for IndexedDB, never file://.
+    with TemporaryDirectory(prefix='qa-media-browser-') as profile:
+        server = ThreadingHTTPServer(('127.0.0.1', 0), partial(QuietHandler, directory=str(ROOT / 'app/src/main/assets')))
+        Thread(target=server.serve_forever, daemon=True).start()
+        url = f'http://127.0.0.1:{server.server_port}/media-import-ownership.js'
+        home = f'http://127.0.0.1:{server.server_port}/'
+        try:
+            with sync_playwright() as p:
+                for session in range(2):
+                    context = p.chromium.launch_persistent_context(
+                        user_data_dir=profile, headless=True,
+                        executable_path=os.environ.get('CHROMIUM_BIN', '/usr/bin/chromium'),
+                        args=['--disable-dev-shm-usage'],
+                    )
+                    page = context.new_page()
+                    page.goto(home)
+                    page.add_script_tag(url=url)
+                    if session == 0:
+                        results = page.evaluate(r'''async () => {
+                          const api = MediaImportOwnership;
+                          const same = (a,b) => JSON.stringify(a)===JSON.stringify(b);
+                          function check(x,message){if(!x)throw Error(message)}
+                          const was = await api.inspect('image_100');
+                          check(was === null, 'fresh private profile already has photo');
+                          await api.reserve('image_100','request_100');
+                          check((await api.inspect('image_100')).phase==='reserved','not reserved');
+                          await api.published('image_100','request_100');
+                          check(same(await api.inspect('image_100'),{owner:'request_100',phase:'published'}),'published mismatch');
+                          const both=await Promise.allSettled([
+                            api.reserve('photo_201','request_201'),api.reserve('photo_202','request_202')]);
+                          check(both.every(r=>r.status==='fulfilled'),'concurrent distinct commits failed');
+                          check((await api.inspect('photo_201')).owner==='request_201','lost receipt 201');
+                          check((await api.inspect('photo_202')).owner==='request_202','lost receipt 202');
+                          const compete=await Promise.allSettled([
+                            api.reserve('photo_203','request_203'),api.reserve('photo_203','request_204')]);
+                          check(compete.filter(r=>r.status==='fulfilled').length===1,'duplicate ownership');
+                          check((await api.inspect('photo_203')).owner==='request_203','first owner not preserved');
+                          try {await api.published('image_100','foreign_owner');throw Error('stolen publish succeeded');}
+                          catch(e){check(!/stolen publish succeeded/.test(String(e)),String(e));}
+                          try {await api.reserve('../bad','request_100');throw Error('traversal accepted');}
+                          catch(e){check(!/traversal accepted/.test(String(e)),String(e));}
+                          // Intercept REAL IndexedDB add success and synchronously abort the actual tx.
+                          // This is a real browser rollback, not an in-memory fake store.
+                          let abortAdd = true;
+                          const origAdd=IDBObjectStore.prototype.add;
+                          IDBObjectStore.prototype.add=function(...args){
+                            const req=origAdd.apply(this,args);
+                            if(abortAdd){abortAdd=false;const tx=this.transaction;
+                              req.addEventListener('success',()=>tx.abort(),{once:true});}
+                            return req;
+                          };
+                          let rejected = false;
+                          try {await api.reserve('photo_abort_01','request_205');}
+                          catch(e){rejected=true;}
+                          IDBObjectStore.prototype.add=origAdd;
+                          check(rejected,'aborted reserve falsely reported success');
+                          check(await api.inspect('photo_abort_01')===null,'aborted receipt on disk');
+                          await api.reserve('photo_pending_01','request_206');
+                          let abortPut=true;
+                          const origPut=IDBObjectStore.prototype.put;
+                          IDBObjectStore.prototype.put=function(...args){
+                            const req=origPut.apply(this,args);
+                            if(abortPut){abortPut=false;const tx=this.transaction;
+                              req.addEventListener('success',()=>tx.abort(),{once:true});}
+                            return req;
+                          };
+                          rejected=false;
+                          try {await api.published('photo_pending_01','request_206');}
+                          catch(e){rejected=true;}
+                          IDBObjectStore.prototype.put=origPut;
+                          check(rejected,'aborted publish falsely succeeded');
+                          check((await api.inspect('photo_pending_01')).phase==='reserved',
+                                'abort published a reserved receipt');
+                          return ['real commit', '2 concurrent', 'contested owner',
+                                  'invalid owner/path', 'abort add', 'abort put'];
+                        }''')
+                        print('PASS real IndexedDB Chromium:', ', '.join(results))
+                    else:
+                        result = page.evaluate(r'''async () => {
+                          const a=await MediaImportOwnership.inspect('image_100');
+                          const b=await MediaImportOwnership.inspect('photo_201');
+                          const c=await MediaImportOwnership.inspect('photo_202');
+                          const d=await MediaImportOwnership.inspect('photo_abort_01');
+                          const e=await MediaImportOwnership.inspect('photo_pending_01');
+                          if(a?.phase!=='published'||b?.phase!=='reserved'||c?.phase!=='reserved'||
+                             d!==null||e?.phase!=='reserved') throw Error('Disk persistence / aborted transaction changed on Chromium restart');
+                          return 'disk-backed receipts survived whole Chromium process restart';
+                        }''')
+                        print('PASS browser-process restart:', result)
+                    context.close()
+        finally:
+            server.shutdown()
+            server.server_close()
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/tests/media_import_transaction_faults.js b/tests/media_import_transaction_faults.js
new file mode 100644
index 0000000..5424b54
--- /dev/null
+++ b/tests/media_import_transaction_faults.js
@@ -0,0 +1,344 @@
+/* N4-A deterministic fault-injection model for MediaImportOwnership.
+ * Models staged writes, atomic COMMIT/abort and serialized transactions on
+ * the same IndexedDB object store; NOT a real browser or disk persistence test.
+ */
+'use strict';
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+
+const source = fs.readFileSync('app/src/main/assets/media-import-ownership.js', 'utf8');
+
+function transactionalIndexedDB() {
+  const committed = new Map();
+  const waiting = [];
+  let active = null, openFault = false, commitFault = null, opened = 0;
+  let heldError = null;
+  function startNext() {
+    if (active || !waiting.length) return;
+    const next = waiting.shift();
+    active = next;
+    // The selected slot may be cancelled before this microtask runs.
+    queueMicrotask(() => { if (active === next) next.start(); });
+  }
+  const database = {
+    objectStoreNames: {contains: name => name === 'imports'},
+    createObjectStore() { throw Error('Unnecessary schema migration'); },
+    close() {},
+    transaction(name, mode) {
+      assert.equal(name, 'imports');
+      assert.ok(mode === 'readwrite' || mode === 'readonly');
+      // A queued write MUST read committed state when it starts, not when
+      // transaction() is called. This model conservatively queues reads too.
+      let staged, started = false, finished = false, scheduled = false;
+      let operation = 'inspect';
+      const requests = [];
+      const slot = {start() {
+        if (finished) return; // Cancelled after selection, before activation.
+        started = true;
+        staged = new Map(committed);
+        pump();
+      }};
+      function release() {
+        assert.equal(active, slot, 'A transaction released someone else\'s lock');
+        active = null;
+        startNext();
+      }
+      const tx = {
+        error: null, oncomplete: null, onabort: null, onerror: null,
+        abort() {
+          if (finished) return;
+          finished = true;
+          const ownsLock = active === slot;
+          if (!ownsLock) {
+            // A queued transaction has no lock to release. Remove only its
+            // own entry so it cannot later overwrite a committed receipt.
+            const index = waiting.indexOf(slot);
+            assert.ok(index >= 0, 'Cancelled transaction is neither active nor queued');
+            waiting.splice(index, 1);
+          }
+          queueMicrotask(() => {
+            try { tx.onabort?.(); }
+            finally { if (ownsLock) release(); }
+          });
+        },
+        objectStore(key) {
+          assert.equal(key, 'imports');
+          function request(fn) {
+            const req = {result: undefined, error: null, onsuccess: null, onerror: null};
+            requests.push({req, fn});
+            pump();
+            return req;
+          }
+          return {
+            add(value, id) {
+              assert.equal(mode, 'readwrite');
+              operation = 'reserve';
+              return request(() => {
+                if (staged.has(id)) throw Error('ConstraintError: duplicate owner');
+                staged.set(id, {...value});
+                return id;
+              });
+            },
+            get(id) { return request(() => staged.get(id) && {...staged.get(id)}); },
+            put(value, id) {
+              assert.equal(mode, 'readwrite');
+              operation = 'published';
+              return request(() => { staged.set(id, {...value}); return id; });
+            }
+          };
+        }
+      };
+      function requestError(req, error) {
+        req.error = error;
+        tx.error = error;
+        const event = {type: 'error', target: req, bubbles: true};
+        // IndexedDB request errors bubble to the transaction before auto-abort.
+        try { req.onerror?.(event); tx.onerror?.(event); }
+        finally {
+          const pause = heldError;
+          heldError = null;
+          if (pause) {
+            pause.observed();
+            pause.resume.then(() => queueMicrotask(() => tx.abort()));
+          } else queueMicrotask(() => tx.abort());
+        }
+      }
+      function pump() {
+        if (!started || finished || scheduled) return;
+        scheduled = true;
+        queueMicrotask(() => {
+          scheduled = false;
+          if (finished) return;
+          const item = requests.shift();
+          if (!item) { finish(); return; }
+          try { item.req.result = item.fn(); }
+          catch (error) { requestError(item.req, error); return; }
+          try { item.req.onsuccess?.(); }
+          catch (error) { tx.error = error; tx.abort(); return; }
+          pump(); // Includes requests queued by onsuccess (get -> put).
+        });
+      }
+      function finish() {
+        if (finished || requests.length) return;
+        if (mode === 'readwrite' && commitFault === operation) {
+          commitFault = null;
+          tx.error = Error('QuotaExceededError: commit interrupted');
+          tx.abort();
+          return;
+        }
+        finished = true;
+        if (mode === 'readwrite') {
+          committed.clear();
+          for (const [id, value] of staged) committed.set(id, {...value});
+        }
+        try { tx.oncomplete?.(); } finally { release(); }
+      }
+      waiting.push(slot);
+      startNext();
+      return tx;
+    }
+  };
+  return {
+    committed,
+    failNextOpen() { openFault = true; },
+    failNextCommit(phase) {assert.ok(['reserve', 'published'].includes(phase)); commitFault = phase;},
+    holdNextRequestErrorAbort() {
+      assert.equal(heldError, null);
+      let observed, resumeAbort;
+      const whenError = new Promise(resolve => { observed = resolve; });
+      const resume = new Promise(resolve => { resumeAbort = resolve; });
+      heldError = {observed, resume};
+      return {whenError, resumeAbort};
+    },
+    get openCount() { return opened; },
+    get pendingCount() { return waiting.length; },
+    get hasActiveTransaction() { return active !== null; },
+    open(name, version) {
+      assert.equal(name, 'zamerovac-import-ownership');
+      assert.equal(version, 1);
+      ++opened;
+      const req = {result: database, onupgradeneeded: null, onsuccess: null, onblocked: null};
+      queueMicrotask(() => {
+        if (openFault) { openFault = false; req.onblocked?.(); }
+        else { req.onupgradeneeded?.(); req.onsuccess?.(); }
+      });
+      return req;
+    }
+  };
+}
+
+function withDeadline(promise, label) {
+  let timer;
+  const deadline = new Promise((_, reject) => {
+    timer = setTimeout(() => reject(Error(label)), 1500);
+  });
+  return Promise.race([promise, deadline]).finally(() => clearTimeout(timer));
+}
+
+function browserSession(indexedDB) {
+  const sandbox = {indexedDB, queueMicrotask};
+  vm.createContext(sandbox);
+  vm.runInContext(source, sandbox, {filename: 'media-import-ownership.js'});
+  assert.ok(Object.isFrozen(sandbox.MediaImportOwnership));
+  return sandbox.MediaImportOwnership;
+}
+
+(async () => {
+  const indexedDB = transactionalIndexedDB();
+  const importer = browserSession(indexedDB);
+  const id = 'original_photo_01', owner = 'request_001';
+
+  indexedDB.failNextOpen();
+  await assert.rejects(importer.reserve(id, owner), /blokována/);
+  assert.equal(indexedDB.committed.size, 0, 'Blocked open wrote a receipt');
+  await importer.reserve(id, owner);
+  assert.equal(indexedDB.openCount, 2, 'Blocked opening poisoned all retries');
+  assert.equal((await importer.inspect(id)).phase, 'reserved');
+
+  indexedDB.failNextCommit('reserve');
+  await assert.rejects(importer.reserve('original_photo_02', owner), /commit interrupted/);
+  assert.equal(await importer.inspect('original_photo_02'), null,
+    'Aborted reserve was reported as a durable receipt');
+  assert.equal(indexedDB.committed.size, 1);
+  await importer.reserve('original_photo_02', owner);
+  assert.equal((await importer.inspect('original_photo_02')).phase, 'reserved');
+
+  indexedDB.failNextCommit('published');
+  await assert.rejects(importer.published(id, owner), /commit interrupted/);
+  assert.equal((await importer.inspect(id)).phase, 'reserved',
+    'Abort incorrectly promoted an unconfirmed imported file');
+  await importer.published(id, owner);
+  assert.equal((await importer.inspect(id)).phase, 'published');
+
+  await assert.rejects(importer.reserve(id, 'request_999'));
+  await assert.rejects(importer.published('absent_photo_03', owner));
+  await assert.rejects(importer.published('original_photo_02', 'request_999'));
+  assert.equal((await importer.inspect('original_photo_02')).phase, 'reserved');
+  assert.equal((await importer.inspect(id)).owner, owner);
+
+  // Parallel readwrite on the same store must not lose either receipt.
+  const distinct = await Promise.allSettled([
+    importer.reserve('parallel_photo_01', 'parallel_owner_01'),
+    importer.reserve('parallel_photo_02', 'parallel_owner_02')
+  ]);
+  assert.deepEqual(distinct.map(result => result.status), ['fulfilled', 'fulfilled']);
+  assert.equal((await importer.inspect('parallel_photo_01')).owner, 'parallel_owner_01');
+  assert.equal((await importer.inspect('parallel_photo_02')).owner, 'parallel_owner_02');
+  assert.equal(indexedDB.committed.size, 4, 'Concurrent writes overwrote durable receipts');
+
+  // Competing owners on one photo: exactly one write can commit.
+  const same = await Promise.allSettled([
+    importer.reserve('contested_photo_01', 'competing_owner_01'),
+    importer.reserve('contested_photo_01', 'competing_owner_02')
+  ]);
+  assert.deepEqual(same.map(result => result.status), ['fulfilled', 'rejected']);
+  assert.equal((await importer.inspect('contested_photo_01')).owner, 'competing_owner_01');
+  assert.equal(indexedDB.committed.size, 5);
+
+  // A failed COMMIT must never erase an earlier successful writer.
+  indexedDB.failNextCommit('reserve');
+  const concurrentAbort = await Promise.allSettled([
+    importer.reserve('aborted_photo_01', 'parallel_owner_01'),
+    importer.reserve('surviving_photo_01', 'parallel_owner_02')
+  ]);
+  assert.deepEqual(concurrentAbort.map(result => result.status), ['rejected', 'fulfilled']);
+  assert.equal(await importer.inspect('aborted_photo_01'), null);
+  assert.equal((await importer.inspect('surviving_photo_01')).owner, 'parallel_owner_02');
+  assert.equal((await importer.inspect(id)).phase, 'published');
+  assert.equal(indexedDB.committed.size, 6);
+
+  // Request error -> transaction.onerror must reject BEFORE tx.onabort.
+  // Holding auto-abort exposes a missing onerror handler (rather than masking
+  // it with the eventual onabort rejection).
+  const gate = indexedDB.holdNextRequestErrorAbort();
+  const rejectedByError = importer.reserve('contested_photo_01', 'foreign_owner_01');
+  await gate.whenError;
+  let errorOutcome = 'pending';
+  rejectedByError.then(() => { errorOutcome = 'fulfilled'; },
+    () => { errorOutcome = 'rejected'; });
+  await Promise.resolve();
+  await Promise.resolve();
+  assert.equal(errorOutcome, 'rejected', 'tx.onerror did not reject before auto-abort');
+  gate.resumeAbort();
+  await assert.rejects(rejectedByError, /ConstraintError/);
+  assert.equal((await importer.inspect('contested_photo_01')).owner, 'competing_owner_01');
+
+  // QA-105-01: aborting the SECOND (queued) write must not release the
+  // FIRST writer's lock, and a THIRD queued write must still commit.
+  // The cancelled request is intentionally queued before tx.abort().
+  const abortFake = transactionalIndexedDB();
+  const openReq = abortFake.open('zamerovac-import-ownership', 1);
+  const rawDb = await new Promise(resolve => { openReq.onsuccess = () => resolve(openReq.result); });
+  const events = [];
+  const first = rawDb.transaction('imports', 'readwrite');
+  first.objectStore('imports').add({owner: 'first_owner', phase: 'reserved'}, 'first_receipt');
+  const firstDone = new Promise((resolve, reject) => {
+    first.oncomplete = () => { events.push('first COMMIT'); resolve(); };
+    first.onerror = () => reject(first.error || Error('First writer failed'));
+    first.onabort = () => reject(Error('First writer aborted'));
+  });
+  const cancelled = rawDb.transaction('imports', 'readwrite');
+  cancelled.objectStore('imports').add({owner: 'cancelled_owner', phase: 'reserved'}, 'cancelled_receipt');
+  const cancelledDone = new Promise((resolve, reject) => {
+    cancelled.onabort = () => { events.push('second ABORT'); resolve(); };
+    cancelled.oncomplete = () => reject(Error('Queued cancelled writer committed'));
+  });
+  const third = rawDb.transaction('imports', 'readwrite');
+  third.objectStore('imports').add({owner: 'third_owner', phase: 'reserved'}, 'third_receipt');
+  const thirdDone = new Promise((resolve, reject) => {
+    third.oncomplete = () => { events.push('third COMMIT'); resolve(); };
+    third.onerror = () => reject(third.error || Error('Third writer failed'));
+    third.onabort = () => reject(Error('Third writer aborted'));
+  });
+  assert.equal(abortFake.pendingCount, 2);
+  cancelled.abort(); // Still in waiting, with the first writer holding active.
+  assert.equal(abortFake.pendingCount, 1);
+  await withDeadline(Promise.all([firstDone, cancelledDone, thirdDone]),
+    'Queued-abort test hung');
+  assert.ok(events.indexOf('first COMMIT') < events.indexOf('third COMMIT'),
+    'Third writer committed before the first owner released the lock');
+  assert.equal(abortFake.committed.get('first_receipt').owner, 'first_owner');
+  assert.equal(abortFake.committed.has('cancelled_receipt'), false);
+  assert.equal(abortFake.committed.get('third_receipt').owner, 'third_owner');
+  assert.equal(abortFake.committed.size, 2);
+  assert.equal(abortFake.pendingCount, 0, 'Cancelled slot remained queued');
+  assert.equal(abortFake.hasActiveTransaction, false, 'Queue retained an active lock');
+
+  // Also abort after startNext() selected the active slot but before its
+  // queued slot.start(): it must skip that start and release exactly once.
+  const selectedFake = transactionalIndexedDB();
+  const selectedOpen = selectedFake.open('zamerovac-import-ownership', 1);
+  const selectedDb = await new Promise(resolve => {
+    selectedOpen.onsuccess = () => resolve(selectedOpen.result);
+  });
+  const selected = selectedDb.transaction('imports', 'readwrite');
+  selected.objectStore('imports').add({owner: 'aborted_owner', phase: 'reserved'}, 'before_start');
+  const selectedAbort = new Promise((resolve, reject) => {
+    selected.onabort = resolve;
+    selected.oncomplete = () => reject(Error('Selected aborted writer committed'));
+  });
+  const afterSelected = selectedDb.transaction('imports', 'readwrite');
+  afterSelected.objectStore('imports').add({owner: 'following_owner', phase: 'reserved'}, 'after_start');
+  const followingCommit = new Promise((resolve, reject) => {
+    afterSelected.oncomplete = resolve;
+    afterSelected.onabort = () => reject(Error('Following writer aborted'));
+    afterSelected.onerror = () => reject(afterSelected.error || Error('Following writer failed'));
+  });
+  selected.abort(); // Active lock is assigned, but selected.start() has not run.
+  await withDeadline(Promise.all([selectedAbort, followingCommit]),
+    'Selected-slot abort hung');
+  assert.equal(selectedFake.committed.has('before_start'), false);
+  assert.equal(selectedFake.committed.get('after_start').owner, 'following_owner');
+  assert.equal(selectedFake.pendingCount, 0);
+  assert.equal(selectedFake.hasActiveTransaction, false);
+
+  // A new JS VM shares the fake in-memory Map. This is NOT disk-persistent
+  // IndexedDB after a WebView/Android restart or device power loss.
+  const reopened = browserSession(indexedDB);
+  assert.equal((await reopened.inspect(id)).phase, 'published');
